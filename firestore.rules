rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Autenticado, com perfil, e que NÃO esteja desativado.
    // (campo `ativo` ausente = tratado como ativo, para retrocompatibilidade)
    function isAtivo() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().get('ativo', true) != false;
    }

    function isAdmin() {
      return isAtivo() && userData().role == 'admin';
    }

    function papel() {
      return userData().get('role', '');
    }

    // Override da pessoa em `permissoes[nome]`, senão o padrão informado.
    function cap(nome, padrao) {
      return userData().get('permissoes', {}).get(nome, padrao);
    }

    // Equipe Imagine (admin ou marketing) — enxerga o painel completo.
    // NUNCA incluir 'colaborador' aqui: cerca de 30 regras e os helpers de
    // capacidade com padrão true (questionários, links públicos, convites)
    // partem de isStaff(), e o colaborador passaria a ler e gravar tudo isso.
    function isStaff() {
      return isAtivo()
        && (userData().get('role', '') == 'admin' || userData().get('role', '') == 'marketing');
    }

    // Colaborador: pessoa de fora do time fixo (ex.: um designer). Fica FORA de
    // isStaff() de propósito e só entra nas áreas marcadas no convite — hoje,
    // só o quadro de atividades, e nele só as demandas em que é o responsável.
    function isColaborador() {
      return isAtivo() && papel() == 'colaborador';
    }

    // Artista ativo cujo login está amarrado a ESTE slug (e só a ele).
    function isArtistaDe(slug) {
      return isAtivo()
        && userData().get('role', '') == 'artista'
        && userData().get('artistaSlug', '') == slug;
    }

    // Permissão efetiva por pessoa: override em users/{uid}.permissoes[cap] se
    // existir, senão o padrão do papel (passado como `padrao`). `isAtivo()`
    // curto-circuita antes de tocar userData() (seguro p/ sem-doc/sem-login).
    // Espelha `temPermissao` (@/lib/permissions) e os guards da API.
    //
    // Receita, importação e agenda também levam `isStaff()` na frente: sem ele,
    // um override solto em qualquer login ativo (até de artista) liberava a
    // coleção inteira. O portal do artista não lê nenhuma das três.
    function podeVerReceita() {
      return isStaff() && cap('verReceita', papel() == 'admin');
    }
    function podeImportar() {
      return isStaff() && cap('importar', papel() == 'admin');
    }
    function podeAgenda() {
      return isStaff() && cap('agenda', true);
    }
    // Quadro de atividades (kanban do atendimento). Padrão: admin e marketing.
    // O `isStaff()` na frente evita que um override solto num login de artista
    // vire acesso às demandas do time inteiro (mesmo motivo de podeEditarArtistas).
    function podeAtividades() {
      return isStaff()
        && userData().get('permissoes', {}).get('atividades', true);
    }
    // Colaborador com a área Atividades marcada. Padrão FECHADO: só vale o que
    // o convite (ou o admin, depois) ligou. As regras do quadro ainda recortam
    // por `responsavelUid` — ele nunca enxerga a demanda dos outros.
    function colaboradorAtividades() {
      return isColaborador() && cap('atividades', false) == true;
    }
    // Áreas que um convite de colaborador pode trazer. Espelha
    // `CONCEDIVEIS.colaborador` (@/lib/permissions): só o que tem regra própria
    // aqui embaixo. Pelo menos uma marcada — colaborador sem área não entra.
    function permissoesColaboradorValidas(p) {
      return p is map
        && p.keys().hasOnly(['atividades'])
        && p.values().hasOnly([true, false])
        && p.values().hasAny([true]);
    }
    // Contratos do artista (ficha + link do documento). Padrão só ADMIN — traz
    // vigência, percentual e o documento assinado. O admin libera na matriz quem
    // mais precisar; `isStaff()` na frente impede override em login de artista.
    function podeContratos() {
      return isStaff()
        && userData().get('permissoes', {}).get('contratos', userData().get('role', '') == 'admin');
    }
    // Quem mantém o cadastro do artista (admin e marketing por padrão). O `isStaff()`
    // na frente é de propósito: o padrão do papel `artista` é FALSE, mas um override
    // solto no login de um artista não pode virar acesso ao dado alheio.
    function podeEditarArtistas() {
      return isStaff()
        && userData().get('permissoes', {}).get('editarArtistas', true);
    }
    // Quem convida ARTISTA pro portal (admin e marketing por padrão). Vale só para
    // convites com role 'artista' — convidar admin/marketing segue exclusivo do
    // admin (cada regra de `convites` abaixo confere o role do convite).
    function podeConvidarArtistas() {
      return isStaff()
        && userData().get('permissoes', {}).get('convidarArtistas', true);
    }

    function convite(token) {
      return get(/databases/$(database)/documents/convites/$(token)).data;
    }

    // Perfis / membros do time
    match /users/{userId} {
      // O próprio usuário sempre lê o seu doc (pra descobrir se foi desativado).
      // Ler/listar os demais membros exige estar ativo.
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isStaff();

      // Admin gerencia membros diretamente, OU a própria pessoa cria seu doc
      // ao aceitar um convite válido (a role vem do convite — sem auto-promoção).
      // `hasOnly` e a igualdade de `permissoes` com o convite fecham o outro
      // caminho de escalada: sem eles, o convidado gravava junto um mapa de
      // permissões próprio (ex.: verReceita) no aceite.
      allow create: if isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
               ['email', 'nome', 'role', 'ativo', 'conviteToken', 'artistaSlug', 'permissoes'])
          && request.resource.data.get('ativo', true) == true
          && request.resource.data.email == request.auth.token.email
          && exists(/databases/$(database)/documents/convites/$(request.resource.data.conviteToken))
          && convite(request.resource.data.conviteToken).status == 'pendente'
          && convite(request.resource.data.conviteToken).email == request.resource.data.email
          && convite(request.resource.data.conviteToken).role == request.resource.data.role
          && request.resource.data.get('artistaSlug', '')
               == convite(request.resource.data.conviteToken).get('artistaSlug', '')
          && request.resource.data.get('permissoes', {})
               == convite(request.resource.data.conviteToken).get('permissoes', {})
          // O perfil só nasce junto com o convite virando 'aceito', no MESMO lote.
          // Separados, o convite podia ficar 'pendente' para sempre (aba fechada,
          // rede caída, ou a segunda escrita pulada de propósito) e o mesmo link
          // recriava o acesso de quem o admin removesse depois.
          && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.conviteToken))
               .data.status == 'aceito'
        );

      // Admin gerencia o perfil; a PRÓPRIA pessoa pode mexer só no seu `favoritos`
      // (lista pessoal de artistas) — o `diff().hasOnly` trava pra não tocar role,
      // ativo, permissoes etc. (sem escalonamento de privilégio).
      allow update: if isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritos'])
          && request.resource.data.favoritos is list
        );
      allow delete: if isAdmin();
    }

    // Convites
    match /convites/{token} {
      // Leitura de UM convite por token (link secreto, UUID) é liberada;
      // listar todos é só admin. Quem tem `convidarArtistas` lista SÓ convites de
      // artista — a query PRECISA trazer where('role','==','artista'), senão o
      // Firestore não prova o `resource.data.role` e nega a consulta inteira.
      allow get: if true;
      allow list: if isAdmin()
        || (podeConvidarArtistas() && resource.data.role == 'artista');

      // Admin convida qualquer papel; `convidarArtistas` só cria convite de
      // artista (sem caminho pra marketing emitir convite de admin/marketing).
      // Só o convite de colaborador carrega `permissoes` (as áreas marcadas no
      // convite); nos outros papéis o campo não existe — o aceite copia esse
      // mapa para o perfil, então ele precisa nascer validado aqui.
      allow create: if (
          isAdmin()
          && request.resource.data.role in ['admin', 'marketing', 'colaborador', 'artista']
          && (
            (request.resource.data.role == 'colaborador'
              && permissoesColaboradorValidas(request.resource.data.get('permissoes', null)))
            || (request.resource.data.role != 'colaborador'
              && !('permissoes' in request.resource.data))
          )
        )
        || (
          podeConvidarArtistas()
          && request.resource.data.role == 'artista'
          && !('permissoes' in request.resource.data)
        );

      // Admin gerencia; OU o convidado marca o próprio convite como aceito —
      // e SÓ isso. Sem a trava de campos, quem tinha o link trocava o `role`
      // do convite para admin antes de criar o perfil (o create de `users`
      // confia no role do convite).
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.token.email == resource.data.email
          && resource.data.status == 'pendente'
          && request.resource.data.status == 'aceito'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitoEm'])
          // ...e só no lote que cria o perfil a partir DESTE convite (ver o
          // create de `users`): aceitar sem perfil, ou com o perfil de outro
          // convite, não vale.
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('conviteToken', '')
               == token
        );

      allow delete: if isAdmin()
        || (podeConvidarArtistas() && resource.data.role == 'artista');
    }

    // Cadastro do artista (nome, redes, label): NÃO é sensível para a equipe.
    // Staff (admin/marketing) lê todo o roster; o artista lê SOMENTE o próprio. Escrita só servidor.
    match /artistas/{slug} {
      allow read: if isStaff() || isArtistaDe(slug);
      allow write: if false;
    }

    // Cadastro COMERCIAL do artista (conta do selo, e-mail do projeto, serviços
    // contratados, anotações). SÓ STAFF — nunca o artista: as "anotações gerais"
    // são notas da EQUIPE SOBRE ele, e ele lê o próprio `artistas/{slug}` no portal.
    // Por isso não mora lá: regra é por documento, não esconde campo. Mesmo motivo
    // da receita. Escrita só servidor.
    match /projetos/{slug} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Contratos do artista — ficha (tipo, vigência, percentual, observações) mais o
    // LINK do PDF digitalizado; o arquivo mora no Drive da Imagine, porque o projeto
    // não tem Storage. Subcoleção de `projetos` para herdar a fronteira certa: é
    // documento da relação comercial, e o artista não lê nada aqui.
    //
    // Regra de subcoleção não é herdada — este bloco é o que a libera. CRUD pelo
    // client (é cadastro manual da equipe, como a agenda), exigindo `contratos`.
    // Inventário de Patrimônio Artístico (IPI, IPN, editora, masters, status do
    // catálogo, observações de titularidade). Subcoleção pelo mesmo motivo dos
    // contratos logo abaixo: `projetos/{slug}` libera leitura para toda a equipe,
    // e regra é por documento — não esconde campo. Aqui a leitura exige
    // `contratos` (admin por padrão), que é a fronteira que este conteúdo pede.
    //
    // Escrita SÓ por Admin SDK (`/api/artistas/dossie`): o parecer do catálogo é
    // gravado com data e responsável, e esse carimbo não pode vir do navegador.
    match /projetos/{slug}/patrimonio/{doc} {
      allow read: if podeContratos();
      allow write: if false;
    }

    match /projetos/{slug}/contratos/{id} {
      allow read: if podeContratos();
      allow create, update, delete: if podeContratos();
    }

    // Questionário de estruturação (diagnóstico). Respondem o ARTISTA (no portal) e a
    // EQUIPE (no painel, quando a resposta veio por fora: reunião, WhatsApp, o
    // formulário antigo) — por isso é a única coleção com escrita pelo client fora da
    // agenda. É o MESMO doc pros dois: um questionário por artista e tipo.
    //
    // O slug vem do CAMINHO, não de um campo do doc: o cliente escreve o corpo, e
    // confiar num `slug` de dentro dele deixaria o artista gravar no diagnóstico
    // alheio. `hasOnly` trava o formato — ninguém inventa campo.
    //
    // Cada lado só grava a SUA `origem`: o artista não se passa por equipe e a equipe
    // não forja um "respondido pelo artista". Doc antigo não tem o campo, e aí só o
    // artista escrevia mesmo — daí o padrão do `get`.
    //
    // A equipe também pode gravar SEM tocar na autoria (o save que só guarda o link do
    // arquivo original): num merge, `request.resource.data` já vem com o valor antigo,
    // então "igual ao que estava" é exatamente isso — e não dá pra forjar, porque só
    // preserva o que o doc já dizia. `resource != null` porque no create não há antigo.
    match /diagnosticos/{slug}/questionarios/{tipo} {
      allow read: if isStaff() || isArtistaDe(slug);
      allow create, update: if
        (
          (isArtistaDe(slug) && request.resource.data.get('origem', 'artista') == 'artista')
          || (podeEditarArtistas() && (
                request.resource.data.get('origem', '') == 'equipe'
                || (resource != null && request.resource.data.get('origem', '') == resource.data.get('origem', ''))
             ))
        )
        && request.resource.data.keys().hasOnly(
             ['slug', 'tipo', 'respostas', 'status', 'origem', 'arquivoUrl', 'atualizadoEm', 'enviadoEm'])
        && request.resource.data.slug == slug
        && request.resource.data.tipo == tipo
        && request.resource.data.respostas is map
        // Link do questionário original (Drive/Pipefy) — opcional, mas se vier é texto.
        && (!('arquivoUrl' in request.resource.data) || request.resource.data.arquivoUrl is string);
      allow delete: if false;
    }

    // Link PÚBLICO de preenchimento do questionário (colher respostas sem liberar o
    // portal). Quem gerencia é quem preenche o questionário pelo painel
    // (`podeEditarArtistas`). O PÚBLICO nunca toca esta coleção pelo client: a
    // página `/q/{token}` valida o token na API (Admin SDK) — por isso não há
    // `get: if true` aqui, diferente de `convites`. `update` não existe: link se
    // cria e se revoga (delete), nunca se edita.
    match /links-questionario/{token} {
      allow get, list: if podeEditarArtistas();
      allow create: if podeEditarArtistas()
        && request.resource.data.keys().hasOnly(['slug', 'tipo', 'criadoPor', 'criadoEm'])
        && request.resource.data.slug is string
        && (request.resource.data.tipo == 'artista' || request.resource.data.tipo == 'projeto');
      allow update: if false;
      allow delete: if podeEditarArtistas();
    }

    // A página de Alertas varre TODOS os questionários de uma vez pra avisar quando
    // um artista responde. Query de grupo exige uma regra com prefixo curinga — a
    // do caminho específico acima não autoriza collectionGroup. Só leitura, só staff;
    // o artista continua alcançando o próprio pela regra de cima.
    match /{caminho=**}/questionarios/{tipo} {
      allow read: if isStaff();
    }

    // Receita (SENSÍVEL): só quem tem a permissão `verReceita` (admin por padrão;
    // o admin pode conceder a um membro). Escrita só servidor.
    match /receitas/{slug} {
      allow read: if podeVerReceita();
      allow write: if false;
    }

    match /importacoes/{id} {
      allow read: if podeImportar();
      allow write: if false;
    }

    // Histórico do cadastro/roster de artistas (links de redes). Escrita só servidor.
    match /cadastros/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Métricas de redes sociais (Instagram via Meta, TikTok via Display API): NÃO
    // são sensíveis para a equipe. Staff lê tudo; o artista lê só o próprio slug.
    // Escrita só servidor (Admin SDK).
    match /metricas-sociais/{slug} {
      allow read: if isStaff() || isArtistaDe(slug);
      allow write: if false;
      match /historico/{dia} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
      match /historico-tiktok/{dia} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
      match /historico-youtube/{dia} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
      match /historico-health/{dia} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
      match /historico-streaming/{dia} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
      match /streaming-detalhe/{doc} {
        allow read: if isStaff() || isArtistaDe(slug);
        allow write: if false;
      }
    }

    // Tokens OAuth (SEGREDO: access/refresh token) do TikTok e do YouTube.
    // Ninguém lê/escreve pelo client — só o Admin SDK no servidor. (O catch-all
    // abaixo já negaria, mas explicitamos para deixar a intenção clara.)
    match /tiktok-tokens/{slug} {
      allow read, write: if false;
    }
    match /youtube-tokens/{slug} {
      allow read, write: if false;
    }

    // Status das integrações (ex.: integracoes/meta). Leitura só staff;
    // escrita só servidor.
    match /integracoes/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Configurações gerais do painel (ex.: `configuracoes/geral` com o WhatsApp
    // que recebe as solicitações de vínculo do portal). Legível por QUALQUER
    // membro ativo — o artista precisa do número no portal. Escrita só ADMIN,
    // direto do painel (aba Perfil das Configurações).
    match /configuracoes/{doc} {
      allow read: if isAtivo();
      allow write: if isAdmin();
    }

    // Agenda (eventos: releases, shows, contratos, reuniões). Dado manual da
    // equipe — quem tem a permissão `agenda` (staff por padrão) lê e escreve
    // direto do client (CRUD do painel). O admin pode tirar de um membro.
    match /agenda/{id} {
      allow read: if podeAgenda();
      allow create, update, delete: if podeAgenda();
    }

    // Atividades (kanban do fluxo de atendimento). Dado manual da equipe, igual à
    // agenda: quem tem a permissão `atividades` (staff por padrão) lê e escreve
    // direto do client. Artista NÃO entra — são as demandas internas do time.
    //
    // O colaborador entra recortado: lê, cria, edita, move e exclui SÓ a demanda
    // em que ele é o responsável. A consulta dele PRECISA trazer
    // where('responsavelUid', '==', uid), senão o Firestore nega a lista inteira.
    // Ele não repassa a demanda (o responsável fica sendo ele antes e depois) e
    // não reescreve a autoria (`criadoPor`/`criadoEm`).
    function atividadeDoColaborador(dados) {
      return colaboradorAtividades() && dados.responsavelUid == request.auth.uid;
    }
    function comentaNaDemanda(atividadeId) {
      return colaboradorAtividades()
        && get(/databases/$(database)/documents/atividades/$(atividadeId)).data.get('responsavelUid', null)
             == request.auth.uid;
    }

    // A demanda mãe e as antecessoras do colaborador também têm de ser dele.
    // Sem isso ele penduraria demandas num projeto da equipe (o progresso da
    // mãe é a média das filhas) ou desmontaria a sequência que a equipe montou.
    // O que não muda passa direto; o que muda é conferido um de cada vez, que é
    // como o quadro grava. `getAfter` enxerga a demanda criada no mesmo lote (o
    // projeto montado por modelo); `get`, a que está saindo (a excluída no lote).
    function eraDele(atividadeId) {
      return get(/databases/$(database)/documents/atividades/$(atividadeId)).data.get('responsavelUid', null)
        == request.auth.uid;
    }
    function ficaDele(atividadeId) {
      return getAfter(/databases/$(database)/documents/atividades/$(atividadeId)).data.get('responsavelUid', null)
        == request.auth.uid;
    }
    function paiDoColaboradorOk(id, novoPai, antigoPai) {
      return novoPai == antigoPai
        || (
          (antigoPai == null || eraDele(antigoPai))
          && (novoPai == null || (novoPai != id && ficaDele(novoPai)))
        );
    }
    function antecessorasDoColaboradorOk(id, novas, antigas) {
      let entram = novas.removeAll(antigas);
      let saem = antigas.removeAll(novas);
      return (entram.size() == 0 || (entram.size() == 1 && entram[0] != id && ficaDele(entram[0])))
        && (saem.size() == 0 || (saem.size() == 1 && eraDele(saem[0])));
    }

    match /atividades/{id} {
      allow read: if podeAtividades() || atividadeDoColaborador(resource.data);
      allow create: if podeAtividades()
        || (
          atividadeDoColaborador(request.resource.data)
          && request.resource.data.criadoPor == request.auth.uid
          && paiDoColaboradorOk(id, request.resource.data.get('paiId', null), null)
          && antecessorasDoColaboradorOk(id, request.resource.data.get('dependeDe', []), [])
        );
      allow update: if podeAtividades()
        || (
          atividadeDoColaborador(resource.data)
          && atividadeDoColaborador(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['criadoPor', 'criadoEm'])
          && paiDoColaboradorOk(id, request.resource.data.get('paiId', null), resource.data.get('paiId', null))
          && antecessorasDoColaboradorOk(id,
               request.resource.data.get('dependeDe', []), resource.data.get('dependeDe', []))
        );
      allow delete: if podeAtividades() || atividadeDoColaborador(resource.data);

      // Comentários da demanda. Ficam numa SUBCOLEÇÃO (e não num array no
      // documento, como o checklist e o histórico) porque uma demanda tocada
      // por várias pessoas durante semanas junta dezenas de parágrafos, e eles
      // viajariam em TODA leitura do quadro. Aqui só são lidos quando alguém
      // abre a demanda.
      //
      // Escrever é de quem tem a permissão do quadro; EDITAR e APAGAR, só do
      // próprio autor (ou do admin). Comentário é fala de alguém: reescrever a
      // fala do outro não é edição de dado, é troca de autoria. O `autorUid` é
      // conferido na criação justamente para que essa dona não possa ser
      // forjada.
      //
      // O colaborador só conversa nas demandas dele: a regra lê a demanda mãe
      // para conferir o responsável.
      //
      // A autoria é toda conferida: o nome exibido tem de ser o do perfil de
      // quem grava (é o que `comentar` manda: nome, ou o e-mail sem nome), a
      // data é a do servidor, e editar mexe só no texto. Antes o nome e a
      // edição ficavam livres, e dava para publicar com o nome de outra pessoa
      // e depois trocar o `autorUid` para o dela.
      match /comentarios/{comentarioId} {
        allow read: if podeAtividades() || comentaNaDemanda(id);
        allow create: if (podeAtividades() || comentaNaDemanda(id))
          && request.resource.data.keys().hasOnly(
               ['texto', 'autorUid', 'autorNome', 'em', 'editadoEm', 'criadoEm'])
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.autorNome
               in [userData().get('nome', ''), userData().get('email', '')]
          && request.resource.data.criadoEm == request.time;
        allow update: if (podeAtividades() || comentaNaDemanda(id))
          && (resource.data.autorUid == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editadoEm']);
        allow delete: if (podeAtividades() || comentaNaDemanda(id))
          && (resource.data.autorUid == request.auth.uid || isAdmin());
      }
    }

    // Catálogo de fonogramas (ISRC → título/álbum/UPC/lançamento + o artista dono).
    // Leitura só STAFF: título de faixa não é sensível, mas o doc traz o catálogo
    // do selo INTEIRO, e o artista não precisa listar a obra dos outros. O card do
    // perfil lê com filtro por `artistaSlug` e `limit` — nunca a coleção toda.
    // (O portal do artista continua vendo os títulos do próprio streaming: aquilo
    // passa por `/api/faixas/titulos`, que é servidor e não depende desta regra.)
    //
    // Escrita SÓ por Admin SDK (`/api/fonogramas`): esta coleção é também o cache
    // ISRC→título de que a análise de streaming depende, e um doc mal formado ali
    // envenena aquela tela. A rota valida ISRC e campos antes de gravar.
    match /catalogo-faixas/{isrc} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Demais coleções ficam bloqueadas até serem modeladas.
    // (ao modelar dados reais, exija isAtivo() — e isAdmin() para escrita sensível)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
